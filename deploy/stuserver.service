[Unit]
Description=Stuserver public directory
After=network.target

[Service]
Type=simple
User=stuserver
Group=stuserver
WorkingDirectory=/opt/stuserver
EnvironmentFile=-/etc/stuserver/stuserver.env
ExecStart=/opt/stuserver/stuserver
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadOnlyPaths=/home/stuserver/data/websites.json
ReadOnlyPaths=/opt/stuserver/static
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
